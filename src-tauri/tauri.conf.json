{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Sales",
  "version": "0.1.0",
  "identifier": "ch.swen-loeffler.tinysales",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tiny Sales",
        "width": 1480,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NEIyNUM3QjUzMTZBMUYKUldRZmFqRzF4eVZMMkpab3I4bitQZm84aXV2VlNCc1ZRcWxvT3V2YnRFcFRWRkF6ZGRJbWJzZDEK",
      "endpoints": [
        "https://github.com/Spooner8/tiny-sales/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
